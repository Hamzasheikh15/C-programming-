#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_SEATS 40

// Structure for passenger
struct Passenger {
    int seatNo;
    char name[50];
    int age;
    char gender[10];
    struct Passenger *next;
};

// Structure for bus
struct Bus {
    int busNo;
    char busName[50];
    char source[50];
    char destination[50];
    int totalSeats;
    int availableSeats;
    struct Passenger *passengers;
    struct Bus *next;
};

struct Bus *busHead = NULL;

// Function to create a new bus
void addBus(int busNo, char busName[], char source[],
           char destination[], int totalSeats) {

    struct Bus *newBus = (struct Bus *)malloc(sizeof(struct Bus));

    newBus->busNo = busNo;
    strcpy(newBus->busName, busName);
    strcpy(newBus->source, source);
    strcpy(newBus->destination, destination);
    newBus->totalSeats = totalSeats;
    newBus->availableSeats = totalSeats;
    newBus->passengers = NULL;
    newBus->next = NULL;

    if (busHead == NULL) {
        busHead = newBus;
    } else {
        struct Bus *temp = busHead;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        temp->next = newBus;
    }
}

// Find bus by bus number
struct Bus *findBus(int busNo) {
    struct Bus *temp = busHead;

    while (temp != NULL) {
        if (temp->busNo == busNo) {
            return temp;
        }
        temp = temp->next;
    }

    return NULL;
}

// Check whether a seat is already reserved
int seatBooked(struct Bus *bus, int seatNo) {
    struct Passenger *temp = bus->passengers;

    while (temp != NULL) {
        if (temp->seatNo == seatNo) {
            return 1;
        }
        temp = temp->next;
    }

    return 0;
}

// Reserve a seat
void reserveSeat() {

    int busNo, seatNo, age;
    char name[50], gender[10];

    printf("\nEnter Bus Number: ");
    scanf("%d", &busNo);

    struct Bus *bus = findBus(busNo);

    if (bus == NULL) {
        printf("\nBus not found!\n");
        return;
    }

    if (bus->availableSeats == 0) {
        printf("\nSorry! No seats available.\n");
        return;
    }

    printf("Enter Seat Number (1-%d): ", bus->totalSeats);
    scanf("%d", &seatNo);

    if (seatNo < 1 || seatNo > bus->totalSeats) {
        printf("\nInvalid seat number!\n");
        return;
    }

    if (seatBooked(bus, seatNo)) {
        printf("\nSeat already reserved!\n");
        return;
    }

    printf("Enter Passenger Name: ");
    scanf(" %[^\n]", name);

    printf("Enter Age: ");
    scanf("%d", &age);

    printf("Enter Gender: ");
    scanf("%s", gender);

    struct Passenger *newPassenger =
        (struct Passenger *)malloc(sizeof(struct Passenger));

    newPassenger->seatNo = seatNo;
    strcpy(newPassenger->name, name);
    newPassenger->age = age;
    strcpy(newPassenger->gender, gender);
    newPassenger->next = NULL;

    if (bus->passengers == NULL) {
        bus->passengers = newPassenger;
    } else {
        struct Passenger *temp = bus->passengers;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        temp->next = newPassenger;
    }

    bus->availableSeats--;

    printf("\n=================================\n");
    printf("       RESERVATION SUCCESSFUL\n");
    printf("=================================\n");
    printf("Bus Number : %d\n", bus->busNo);
    printf("Bus Name   : %s\n", bus->busName);
    printf("Passenger  : %s\n", name);
    printf("Seat No.   : %d\n", seatNo);
    printf("From       : %s\n", bus->source);
    printf("To         : %s\n", bus->destination);
    printf("=================================\n");
}

// Cancel reservation
void cancelReservation() {

    int busNo, seatNo;

    printf("\nEnter Bus Number: ");
    scanf("%d", &busNo);

    struct Bus *bus = findBus(busNo);

    if (bus == NULL) {
        printf("\nBus not found!\n");
        return;
    }

    printf("Enter Seat Number to Cancel: ");
    scanf("%d", &seatNo);

    struct Passenger *temp = bus->passengers;
    struct Passenger *prev = NULL;

    while (temp != NULL) {

        if (temp->seatNo == seatNo) {

            if (prev == NULL) {
                bus->passengers = temp->next;
            } else {
                prev->next = temp->next;
            }

            printf("\nReservation cancelled successfully!\n");
            printf("Passenger: %s\n", temp->name);
            printf("Seat No.: %d\n", temp->seatNo);

            free(temp);

            bus->availableSeats++;

            return;
        }

        prev = temp;
        temp = temp->next;
    }

    printf("\nNo reservation found for this seat.\n");
}

// Display all buses
void displayBuses() {

    if (busHead == NULL) {
        printf("\nNo buses available.\n");
        return;
    }

    struct Bus *temp = busHead;

    printf("\n============================================================\n");
    printf("                    AVAILABLE BUSES\n");
    printf("============================================================\n");

    printf("%-10s %-20s %-15s %-15s %-10s\n",
           "Bus No", "Bus Name", "Source", "Destination", "Available");

    printf("------------------------------------------------------------\n");

    while (temp != NULL) {

        printf("%-10d %-20s %-15s %-15s %-10d\n",
               temp->busNo,
               temp->busName,
               temp->source,
               temp->destination,
               temp->availableSeats);

        temp = temp->next;
    }

    printf("============================================================\n");
}

// Display reservations
void displayReservations() {

    int busNo;

    printf("\nEnter Bus Number: ");
    scanf("%d", &busNo);

    struct Bus *bus = findBus(busNo);

    if (bus == NULL) {
        printf("\nBus not found!\n");
        return;
    }

    if (bus->passengers == NULL) {
        printf("\nNo reservations for this bus.\n");
        return;
    }

    struct Passenger *temp = bus->passengers;

    printf("\n====================================================\n");
    printf("              PASSENGER RESERVATIONS\n");
    printf("====================================================\n");

    printf("%-10s %-25s %-10s %-10s\n",
           "Seat", "Name", "Age", "Gender");

    printf("----------------------------------------------------\n");

    while (temp != NULL) {

        printf("%-10d %-25s %-10d %-10s\n",
               temp->seatNo,
               temp->name,
               temp->age,
               temp->gender);

        temp = temp->next;
    }

    printf("====================================================\n");
}

// Search passenger
void searchPassenger() {

    char name[50];
    int found = 0;

    printf("\nEnter Passenger Name: ");
    scanf(" %[^\n]", name);

    struct Bus *bus = busHead;

    while (bus != NULL) {

        struct Passenger *passenger = bus->passengers;

        while (passenger != NULL) {

            if (strcasecmp(passenger->name, name) == 0) {

                printf("\nPassenger Found!\n");
                printf("--------------------------------\n");
                printf("Name        : %s\n", passenger->name);
                printf("Age         : %d\n", passenger->age);
                printf("Gender      : %s\n", passenger->gender);
                printf("Seat Number : %d\n", passenger->seatNo);
                printf("Bus Number  : %d\n", bus->busNo);
                printf("Bus Name    : %s\n", bus->busName);
                printf("From        : %s\n", bus->source);
                printf("To          : %s\n", bus->destination);
                printf("--------------------------------\n");

                found = 1;
            }

            passenger = passenger->next;
        }

        bus = bus->next;
    }

    if (!found) {
        printf("\nPassenger not found.\n");
    }
}

// Display seat status
void seatStatus() {

    int busNo;

    printf("\nEnter Bus Number: ");
    scanf("%d", &busNo);

    struct Bus *bus = findBus(busNo);

    if (bus == NULL) {
        printf("\nBus not found!\n");
        return;
    }

    printf("\nSeat Status for Bus %d\n", busNo);
    printf("-----------------------------------\n");

    for (int i = 1; i <= bus->totalSeats; i++) {

        if (seatBooked(bus, i)) {
            printf("[ X ] ");
        } else {
            printf("[%2d] ", i);
        }

        if (i % 5 == 0) {
            printf("\n");
        }
    }

    printf("\n[X] = Reserved\n");
    printf("[Number] = Available\n");
}

// Free memory
void freeMemory() {

    struct Bus *bus = busHead;

    while (bus != NULL) {

        struct Passenger *passenger = bus->passengers;

        while (passenger != NULL) {
            struct Passenger *temp = passenger;
            passenger = passenger->next;
            free(temp);
        }

        struct Bus *tempBus = bus;
        bus = bus->next;

        free(tempBus);
    }
}

// Main function
int main() {

    int choice;

    // Adding sample buses
    addBus(101, "Express Bus", "Delhi", "Meerut", 40);
    addBus(102, "Volvo Bus", "Delhi", "Dehradun", 40);
    addBus(103, "City Express", "Meerut", "Haridwar", 30);

    do {

        printf("\n\n==============================================\n");
        printf("          BUS RESERVATION SYSTEM\n");
        printf("==============================================\n");

        printf("1. Display Buses\n");
        printf("2. Reserve Seat\n");
        printf("3. Cancel Reservation\n");
        printf("4. Display Reservations\n");
        printf("5. Search Passenger\n");
        printf("6. Display Seat Status\n");
        printf("7. Exit\n");

        printf("==============================================\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

            case 1:
                displayBuses();
                break;

            case 2:
                reserveSeat();
                break;

            case 3:
                cancelReservation();
                break;

            case 4:
                displayReservations();
                break;

            case 5:
                searchPassenger();
                break;

            case 6:
                seatStatus();
                break;

            case 7:
                freeMemory();
                printf("\nThank you for using the Bus Reservation System!\n");
                break;

            default:
                printf("\nInvalid choice! Please try again.\n");
        }

    } while (choice != 7);

    return 0;
}
